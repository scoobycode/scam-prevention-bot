# Copy this file to .env and fill it in. Never commit .env.

# Your bot's token from https://discord.com/developers/applications -> Bot -> Reset Token
BOT_TOKEN=

# Optional: show Scooby's stream as the bot's status (needs Presence Intent in the Developer Portal)
STREAM_STATUS=false

# Optional: post "thanks for upvoting" messages (needs Message Content Intent in the Developer Portal)
UPVOTE_RELAY=false
